{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application, either a teacher or a student.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "role": { "type": "string", "enum": ["teacher", "student"], "description": "Role of the user" },
        "displayName": { "type": "string", "description": "Name of the user" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "teacherCode": { "type": "string", "description": "Unique code for teachers, or the linked teacher's code for students" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "role", "displayName", "email", "createdAt"]
    },
    "Test": {
      "title": "Test",
      "description": "A generated test created by a teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique test ID" },
        "teacherUid": { "type": "string", "description": "UID of the teacher who created the test" },
        "title": { "type": "string", "description": "Title of the test" },
        "testSet": { "type": "string", "description": "JSON stringified test content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "teacherUid", "title", "testSet", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student's submission for a test.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique submission ID" },
        "testId": { "type": "string", "description": "ID of the test" },
        "studentUid": { "type": "string", "description": "UID of the student" },
        "teacherUid": { "type": "string", "description": "UID of the teacher" },
        "answers": { "type": "string", "description": "JSON stringified answers map" },
        "score": { "type": "number", "description": "Calculated score" },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" }
      },
      "required": ["id", "testId", "studentUid", "teacherUid", "answers", "score", "submittedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/tests/{testId}": {
      "schema": { "$ref": "#/entities/Test" },
      "description": "Stores tests generated by teachers."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Stores student test submissions."
    }
  }
}
